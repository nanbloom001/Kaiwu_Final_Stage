# Copy to .env for local overrides. Never put passwords or raw cookies here.
# The persistent Chrome profile stores cookies/localStorage after the first login.
AGENT_BROWSER_SESSION=tencent-arena-persistent-v2
AGENT_BROWSER_SESSION_NAME=tencent-arena-persistent-v2
AGENT_BROWSER_PROFILE=runtime/browser_profile
AGENT_BROWSER_HEADED=1
