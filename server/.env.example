# Copy to server/.env locally, and create an equivalent protected .env file in
# the Tencent IDE project root. Never commit either real file.
#
# Local client:
#   python local_sync_client.py --env-file .env --skip-unchanged
# IDE server:
#   python conf/tongbu.py --env-file .env --root /data/projects/legged_robot_competition_26
#
# Restrict the real file after creating it: chmod 600 .env

IDE_SYNC_TOKEN=replace-with-one-random-shared-value

# Optional local-client values. Do not put browser Cookie values in a file
# shared with anyone else.
# IDE_PROXY_COOKIE=replace-with-current-browser-cookie
# IDE_SYNC_URL=https://tencentarena.com/p5/ide/18005/proxy/8765
